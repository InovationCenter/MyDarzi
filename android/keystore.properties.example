# Copy to keystore.properties and fill in your values.
# keystore.properties is gitignored — never commit real passwords.
#
# Generate the upload keystore once (from the android/ folder):
#   keytool -genkeypair -v -storetype PKCS12 -keystore mydarzi-upload.keystore -alias mydarzi-upload -keyalg RSA -keysize 2048 -validity 10000

storeFile=mydarzi-upload.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=mydarzi-upload
keyPassword=YOUR_KEY_PASSWORD
